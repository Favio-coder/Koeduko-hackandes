# --- Firebase (cliente) ---------------------------------------------------
# Estas claves son PUBLICAS por diseno. La seguridad la garantizan
# Firestore Security Rules, no estas variables.
VITE_FIREBASE_API_KEY=TU_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=TU_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=TU_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=TU_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=TU_SENDER_ID
VITE_FIREBASE_APP_ID=TU_APP_ID

# --- Opcionales -----------------------------------------------------------
# Zona horaria / locale de la interfaz (opcional)
VITE_APP_LOCALE=es

# ======================================================================
# NO AGREGAR AQUI NUNCA:
#   GEMINI_API_KEY
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   Cualquier credencial de Google Meet o Calendar
#
# Esos secretos van en Cloud Functions:
#   firebase functions:secrets:set GEMINI_API_KEY
#
# Cualquier variable VITE_ queda dentro del bundle del navegador y es
# visible para cualquiera que abra la aplicacion.
# ======================================================================